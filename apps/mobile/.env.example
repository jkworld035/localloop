# Copy to apps/mobile/.env for local development. For EAS cloud builds set
# these as EAS environment variables (development / preview / production).
#
# Public values only — anything prefixed EXPO_PUBLIC_ is compiled into the app
# bundle. NEVER put the Supabase service-role key or any server secret here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud → Maps SDK for Android / Maps SDK for iOS keys, restricted to
# the app's package name + SHA-1 (Android) and bundle id (iOS).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# expo.dev project id (eas init writes it); enables push tokens and EAS Update.
EAS_PROJECT_ID=

# development | preview | (unset = production)
APP_VARIANT=development
